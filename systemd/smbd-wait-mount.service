[Unit]
Description=Samba SMB Daemon (Wait for encrypted USB mount)
Documentation=man:smbd(8) man:samba(7) man:smb.conf(5)
After=network.target network-online.target mnt-secure_nas.mount
Wants=network-online.target
# Only start Samba after the encrypted USB is mounted
Requires=mnt-secure_nas.mount
BindsTo=mnt-secure_nas.mount
# NOTE: ConditionPathIsMountPoint was removed intentionally.
# systemd evaluates Condition* at activation time and *silently skips* the unit
# (no error, no journal entry, no retry) when it does not hold. During boot this
# raced with mnt-secure_nas.mount and left smbd dead until started by hand.
# Requires=/BindsTo= already refuse to start smbd without the mount and stop it
# when the mount goes away, so the condition was redundant protection with a
# real failure mode of its own.
#
# Do NOT add x-systemd.wants=smbd.service to the fstab entry to "help" this
# along: combined with After=mnt-secure_nas.mount below it forms an ordering
# cycle, and systemd breaks the cycle by dropping jobs - leaving neither the
# mount nor smbd running. Requires= is enough; the mount pulls itself in from
# local-fs.target and smbd follows it.

[Service]
Type=notify
PIDFile=/run/samba/smbd.pid
LimitNOFILE=16384
EnvironmentFile=-/etc/default/samba
ExecStart=/usr/sbin/smbd --foreground --no-process-group $SMBDOPTIONS
ExecReload=/bin/kill -HUP $MAINPID
LimitCORE=infinity
# Restart if mount becomes unavailable
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
